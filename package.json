{
  "name": "bolo",
  "version": "0.1.0",
  "description": "BOLO build and deploy scripts",
  "private": true,
  "scripts": {
    "build:macos": "cmake --preset macos-debug && cmake --build --preset macos-debug",
    "run:macos": "./build/macos-debug/bolo",
    "build-and-run:macos": "npm run build:macos && ./build/macos-debug/bolo",
    "build:rg353v:final": "cmake --preset rg353v-final --fresh && cmake --build --preset rg353v-final",
    "build:rg353v:debug": "cmake --preset rg353v-debug --fresh && cmake --build --preset rg353v-debug",
    "deploy:rg353v:final": "bash scripts/deploy-rg353v.sh final",
    "deploy:rg353v:debug": "bash scripts/deploy-rg353v.sh debug",
    "ship:rg353v:final": "npm run build:rg353v:final && npm run deploy:rg353v:final",
    "ship:rg353v:debug": "npm run build:rg353v:debug && npm run deploy:rg353v:debug"
  }
}
