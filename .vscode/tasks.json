{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BOLT: Run macOS",
      "type": "shell",
      "command": "npm run run:macos",
      "problemMatcher": []
    },
    {
      "label": "BOLT: Build RG353V Release",
      "type": "shell",
      "command": "npm run build:rg353v:release",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "BOLT: Build RG353V Debug",
      "type": "shell",
      "command": "npm run build:rg353v:debug",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "BOLT: Deploy RG353V Release",
      "type": "shell",
      "command": "RG353V_DEVICE_IP=${input:rg353vDeviceIp} npm run deploy:rg353v:release",
      "problemMatcher": []
    },
    {
      "label": "BOLT: Deploy RG353V Debug",
      "type": "shell",
      "command": "RG353V_DEVICE_IP=${input:rg353vDeviceIp} npm run deploy:rg353v:debug",
      "problemMatcher": []
    },
    {
      "label": "BOLT: Fetch RG353V Logs",
      "type": "shell",
      "command": "RG353V_DEVICE_IP=${input:rg353vDeviceIp} npm run fetch-logs:rg353v",
      "problemMatcher": []
    },
    {
      "label": "BOLT: Remove RG353V Logs",
      "type": "shell",
      "command": "RG353V_DEVICE_IP=${input:rg353vDeviceIp} npm run remove-logs:rg353v",
      "problemMatcher": []
    },
    {
      "label": "BOLT: Build and Deploy RG353V Release",
      "type": "shell",
      "command": "RG353V_DEVICE_IP=${input:rg353vDeviceIp} npm run build-and-deploy:rg353v:release",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "BOLT: Build and Deploy RG353V Debug",
      "type": "shell",
      "command": "RG353V_DEVICE_IP=${input:rg353vDeviceIp} npm run build-and-deploy:rg353v:debug",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "rg353vDeviceIp",
      "type": "promptString",
      "description": "RG353V device IP",
      "default": "192.168.1.42"
    }
  ]
}
